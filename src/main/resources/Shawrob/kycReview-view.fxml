      <Label fx:id="holderNameLabel" layoutX="89.0" layoutY="114.0" prefHeight="17.0" prefWidth="131.0" />
      <Label layoutX="14.0" layoutY="148.0" prefHeight="17.0" prefWidth="39.0" text="Status:" />
      <Label fx:id="statusLabel" layoutX="51.0" layoutY="148.0" prefHeight="17.0" prefWidth="85.0" />
      <Button layoutX="185.0" layoutY="226.0" mnemonicParsing="false" onAction="#reviewOnAction" prefHeight="25.0" prefWidth="201.0" text="Review" />
